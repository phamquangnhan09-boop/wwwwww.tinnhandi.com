<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudentSaver - Cẩm Nang & Mẹo Tiết Kiệm Cho Sinh Viên</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Family Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- 1. HEADER & NAVIGATION -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <div class="bg-emerald-500 text-white p-2 rounded-xl shadow-md">
                    <i data-lucide="wallet" class="w-6 h-6"></i>
                </div>
                <span class="text-xl font-bold bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">
                    StudentSaver
                </span>
            </div>
            <nav class="hidden md:flex items-center space-x-6 font-medium text-slate-600 text-sm">
                <a href="#tips" class="hover:text-emerald-600 transition">Mẹo Tiết Kiệm</a>
                <a href="#calculator" class="hover:text-emerald-600 transition">Tính Ngân Sách</a>
                <a href="#challenge" class="hover:text-emerald-600 transition">Thử Thách 30 Ngày</a>
            </nav>
        </div>
    </header>

    <!-- 2. HERO SECTION -->
    <section class="bg-gradient-to-b from-emerald-50 to-slate-50 py-16 px-4 text-center">
        <div class="max-w-3xl mx-auto space-y-4">
            <span class="inline-block bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
                Bí quyết tài chính cho sinh viên
            </span>
            <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 leading-tight">
                Sống Thoải Mái Dù Rủng Rỉnh Hay "Cháy Túi"
            </h1>
            <p class="text-slate-600 text-base md:text-lg">
                Tổng hợp những chiêu thức tiết kiệm thực tế nhất, công cụ tính toán chi tiêu và thử thách tích lũy tiền dành riêng cho bạn.
            </p>
        </div>
    </section>

    <main class="max-w-6xl mx-auto px-4 py-8 space-y-16 flex-grow">

        <!-- 3. BỘ TÍNH NGÂN SÁCH (BUDGET CALCULATOR) -->
        <section id="calculator" class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200">
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="calculator" class="text-emerald-600"></i>
                    Bảng Tính Ngân Sách Sinh Viên
                </h2>
                <p class="text-slate-500 text-sm">Nhập thu nhập và ước tính chi tiêu hằng tháng của bạn</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Form nhập liệu -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Thu nhập / Chu cấp (VNĐ)</label>
                        <input type="number" id="income" value="4000000" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Tiền nhà & Điện nước (VNĐ)</label>
                        <input type="number" id="rent" value="1500000" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Ăn uống & Đi lại (VNĐ)</label>
                        <input type="number" id="food" value="1500000" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Giải trí & Bè bạn (VNĐ)</label>
                        <input type="number" id="fun" value="500000" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                </div>

                <!-- Kết quả & Biểu đồ -->
                <div class="flex flex-col items-center justify-between bg-slate-50 p-6 rounded-xl border border-slate-200">
                    <div class="w-full max-w-[240px]">
                        <canvas id="budgetChart"></canvas>
                    </div>
                    <div id="calculatorResult" class="w-full text-center mt-4 p-4 rounded-lg bg-emerald-100 text-emerald-900 font-semibold">
                        <!-- Kết quả JS sẽ điền vào đây -->
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. TỔNG HỢP MẸO TIẾT KIỆM (SAVING TIPS) -->
        <section id="tips" class="space-y-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">Mẹo Tiết Kiệm Hay</h2>
                    <p class="text-slate-500 text-sm">Lọc theo chủ đề bạn quan tâm</p>
                </div>
                <!-- Bộ lọc Category -->
                <div class="flex flex-wrap gap-2" id="categoryFilters">
                    <button data-cat="all" class="cat-btn bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Tất cả</button>
                    <button data-cat="food" class="cat-btn bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm font-medium transition hover:bg-slate-100">Ăn uống</button>
                    <button data-cat="living" class="cat-btn bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm font-medium transition hover:bg-slate-100">Nơi ở & Chi phí</button>
                    <button data-cat="study" class="cat-btn bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm font-medium transition hover:bg-slate-100">Học tập & Mua sắm</button>
                </div>
            </div>

            <!-- Danh sách các Thẻ Tip -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="tipsGrid">
                <!-- Tip 1 -->
                <div class="tip-card bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3" data-category="food">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wide">Ăn uống</div>
                    <h3 class="font-bold text-slate-900 text-lg">Nấu ăn theo nhóm hoặc nấu chung</h3>
                    <p class="text-slate-600 text-sm">Góp tiền đi chợ nấu ăn chung với bạn cùng phòng giúp giảm 30-40% chi phí so with ăn tiệm lẻ mần.</p>
                </div>

                <!-- Tip 2 -->
                <div class="tip-card bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3" data-category="living">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wide">Nơi ở & Chi phí</div>
                    <h3 class="font-bold text-slate-900 text-lg">Dùng thiết bị tiết kiệm điện</h3>
                    <p class="text-slate-600 text-sm">Tắt bình nóng lạnh khi không dùng, thay bóng đèn LED và hạn chế bật điều hòa quá thấp (nên để 26-27 độ).</p>
                </div>

                <!-- Tip 3 -->
                <div class="tip-card bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3" data-category="study">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wide">Học tập & Mua sắm</div>
                    <h3 class="font-bold text-slate-900 text-lg">Sử dụng giáo trình PDF / Mua cũ</h3>
                    <p class="text-slate-600 text-sm">Tận dụng thư viện trường, tìm file PDF trực tuyến hoặc mua lại sách cũ từ các anh chị khóa trước.</p>
                </div>

                <!-- Tip 4 -->
                <div class
